# ==========================================
# STICHLY&CO. - Environment Variables Template
# ==========================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# NOTE: Do NOT commit any .env file containing real secrets to version control.

# Server Configuration
PORT=3000
NODE_ENV=development

# GEMINI_API_KEY: Required for Gemini AI API calls (Visual Scanner & Stichly Assistant).
# In production, inject this via cloud environment variables or secret manager.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The public URL where this applet is hosted.
APP_URL="http://localhost:3000"

